# CUSTO DE OPORTUNIDADE vs BENEFÍCIO — o que já foi apresentado no início do pitch
# Fonte dos casos: slide 1 (197/322 dias · US$ 5M), slide 5 (Bacia de Campos:
#        90 GB · 72 h · US$ 15–25M), slide 6 (62% via fornecedor).
# Modelo: 19_Viabilidade_Economica_Modelo.md
# Uso: slide 10 — fecha o pitch com a conta.
#
# Render: bash render.sh   (d2 opportunity_cost.d2 opportunity_cost.svg)

direction: down

vars: {
  d2-config: {
    theme-id: 0
    pad: 20
    sketch: false
  }
}

classes: {
  loss: {
    style: {
      fill: "#131836"
      stroke: "#FF4757"
      stroke-width: 2
      font-color: "#F8F9FB"
      border-radius: 12
    }
  }
  gain: {
    style: {
      fill: "#0A0E27"
      stroke: "#00FF41"
      stroke-width: 3
      font-color: "#00FF41"
      bold: true
      border-radius: 12
    }
  }
  bridge: {
    style: {
      fill: "#131836"
      stroke: "#00D4FF"
      stroke-width: 2
      font-color: "#00D4FF"
      bold: true
      border-radius: 10
    }
  }
  chain: {
    style: {
      stroke: "#3F4262"
      stroke-width: 1
    }
  }
}

# ── Custo de oportunidade ─────────────────────────────────
opportunity: "CUSTO DE OPORTUNIDADE\nse nada mudar" {
  class: loss

  o1: "197 dias de MTTD\nBrasil: 322 dias\njanela do atacante"
  o2: "90 GB · 72 horas\nsísmica 3D via VPN\nlegítima"
  o3: "US\$ 15–25M\ndowntime · contencioso\nIP em dark web"

  o1 -> o2 -> o3: { class: chain }
}

# ── Benefício ─────────────────────────────────────────────
benefit: "BENEFÍCIO COM AXEGUARD" {
  class: gain

  b1: "0 bytes exfiltrados\nDLP bloqueia no L7"
  b2: "MTTD < 12 segundos\nde 197 dias para 12 s"
  b3: "Payback 2,3 meses\n1 incidente evitado = 9,9×"

  b1 -> b2 -> b3: { class: chain }
}

# ── Ponte ─────────────────────────────────────────────────
bridge: "A CONTA\nCusto anualizado da inação: R\$ 40M+ (EAL base)\nTCO 3 anos AxeGuard: R\$ 18,86M\nBenefício líquido 3 anos: R\$ 101,1M  ·  ROI 6,4×" {
  class: bridge
}

opportunity -> bridge: {
  style: {
    stroke: "#FF4757"
    stroke-width: 3
    font-color: "#7B7F95"
  }
}

benefit -> bridge: {
  style: {
    stroke: "#00FF41"
    stroke-width: 3
    font-color: "#7B7F95"
  }
}
