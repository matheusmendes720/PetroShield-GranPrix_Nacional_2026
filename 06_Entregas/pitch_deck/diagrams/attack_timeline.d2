# Timeline do Ataque — Caso Bacia de Campos (Nov/2025)
# Fonte: pitch_deck/06_caso_bacia_de_campos.md
# Uso: slide 5 (coração do pitch) — mostra ONDE o AxeGuard corta a corrente.
#
# Render: d2 attack_timeline.d2 attack_timeline.svg

vars: {
  d2-config: {
    theme-id: 0
    pad: 24
    sketch: false
  }
}

classes: {
  actor: {
    style: {
      fill: "#1F2447"
      stroke: "#7B7F95"
      stroke-width: 1
      font-color: "#C7CAD9"
      border-radius: 6
    }
  }
  bad: {
    style: {
      stroke: "#7B7F95"
      stroke-width: 2
      font-color: "#C7CAD9"
    }
  }
  cut: {
    style: {
      stroke: "#6366F1"
      stroke-width: 3
      font-color: "#6366F1"
      bold: true
    }
  }
  note: {
    style: {
      fill: "#0A0E27"
      stroke: "#6366F1"
      stroke-width: 3
      font-color: "#6366F1"
      bold: true
      border-radius: 8
    }
  }
}

atk: "ATACANTE" {
  class: actor
}

vnd: "FORNECEDOR\n(geofísica)" {
  class: actor
}

api: "VPN/API LEGACY\nPETROBRAS" {
  class: actor
}

soc: "AXEGUARD\nSOC + DLP" {
  class: note
}

# ── T-30d ─────────────────────────────────────────────────
atk -> vnd: "T−30d · PHISHING\ne-mail falso Microsoft → MFA reset\n2FA roubado em tempo real" {
  class: bad
}

# ── T-7d ──────────────────────────────────────────────────
vnd -> vnd: "T−7d · DISCOVERY\ncredenciais VPN em texto claro\narquivo compartilhado · senha única" {
  class: bad
}

# ── T-0 ───────────────────────────────────────────────────
vnd -> api: "T−0 · LOGIN\ncredencial válida · sem 2FA\nsem geofencing · script automatizado" {
  class: bad
}

# ── T+72h ─────────────────────────────────────────────────
vnd -> api: "T+72h · EXFILTRAÇÃO\n90 GB · base64 · DNS-over-HTTPS\nsísmica 3D · mapas de reservatório" {
  class: bad
}

# ── Interrupção ───────────────────────────────────────────
api -> soc: "T−0 · primeira tentativa de exfiltração" {
  class: cut
}

soc -> api: "BLOQUEADO\nOAuth Device Flow + TPM\nDLP: 90 GB / chunked DoH\nMTTD < 12 s · auto-quarantine" {
  class: cut
}

# ── T+90d ─────────────────────────────────────────────────
api -> atk: "T+90d · DESCOBERTA\npor terceiros (dark web)\nUS\$ 15–25M · downtime · contencioso" {
  class: bad
}

out: "SEM AXEGUARD: 90 GB saem. 90 dias de cegueira.\nCOM AXEGUARD: 0 byte. 12 segundos de detecção." {
  style: {
    fill: "#131836"
    stroke: "#6366F1"
    stroke-width: 2
    font-color: "#F8F9FB"
    bold: true
    border-radius: 8
  }
}

soc -> out
