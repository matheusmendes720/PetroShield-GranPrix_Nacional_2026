# DLP Proxy — PetroShield XR
# Fonte: scripts/dlp_proxy/main.py (FastAPI, porta 8000)
# Uso: slide 9 (Camada L2) — mostra que o dado é higienizado ANTES da LLM.
#
# Render: d2 dlp_pipeline.d2 dlp_pipeline.svg

vars: {
  d2-config: {
    theme-id: 0
    pad: 24
    sketch: false
  }
}

classes: {
  stage: {
    style: {
      fill: "#131836"
      stroke: "#6366F1"
      stroke-width: 2
      font-color: "#F8F9FB"
      border-radius: 8
    }
  }
  sub: {
    style: {
      fill: "#1F2447"
      stroke: "#7B7F95"
      stroke-width: 1
      font-color: "#C7CAD9"
      border-radius: 6
    }
  }
  safe: {
    style: {
      fill: "#0A0E27"
      stroke: "#6366F1"
      stroke-width: 3
      font-color: "#6366F1"
      bold: true
      border-radius: 8
    }
  }
  cut: {
    style: {
      fill: "#1F2447"
      stroke: "#7B7F95"
      stroke-width: 1
      font-color: "#7B7F95"
      border-radius: 6
      opacity: 0.6
    }
  }
  flow: {
    style: {
      stroke: "#6366F1"
      stroke-width: 2
      font-color: "#7B7F95"
    }
  }
}

# ── Entrada ───────────────────────────────────────────────
op: "Operador de campo" {
  shape: person
  style.fill: "#1F2447"
  style.stroke: "#7B7F95"
  style.font-color: "#F8F9FB"
}

glasses: "Smart Glasses (XR)\nCâmera + microfone" {
  class: stage
}

op -> glasses: "solicita" {
  class: flow
}

glasses -> proxy: "POST /api/v1/secure-prompt\nquery + device_id" {
  class: flow
}

# ── DLP Proxy ─────────────────────────────────────────────
proxy: "DLP PROXY  :8000\nPetroShield XR Gateway" {
  class: safe

  gate: "① verify_token\nAuthorization: Bearer\n401 sem header · 403 token inválido" {
    class: sub
  }

  redact: "② RedactionEngine\nregex + NLP atômica" {
    class: sub
  }

  gate -> redact: "session ok" {
    class: flow
  }
}

# ── Regras de redação ─────────────────────────────────────
rules: "REGRAS APLICADAS\n\nCPF 123.456.789-00  →  [CPF_BLOQUEADO]\nPlataforma P-52 · poço xyz  →  [ATIVO_RESTRITO]\nsenha / password  →  [CREDENCIAL_BLOQUEADA]" {
  class: sub
}

redact -> rules {
  class: flow
}

# ── Saída ─────────────────────────────────────────────────
enclave: "LLM ENCLAVE\nAzure OpenAI · VNet privada · no-train" {
  class: safe
}

rules -> enclave: "prompt higienizado\nPII mascarada" {
  class: flow
}

audit: "dlp_audit_log\ndevice_id · original_query_length\nsanitized_query · data_leak_prevented" {
  class: sub
}

enclave -> audit: "auditoria de conformidade" {
  class: flow
}

# ── Caminho cortado ───────────────────────────────────────
bypass: "Bypass direto do endpoint\n(exfiltração por DoH / VPN sem proxy)" {
  class: cut
}

bypass -> enclave: "sem passar pelo DLP" {
  style.stroke: "#7B7F95"
  style.stroke-dash: 3
  style.font-color: "#7B7F95"
}

enclave -> glasses: "resposta" {
  class: flow
}
