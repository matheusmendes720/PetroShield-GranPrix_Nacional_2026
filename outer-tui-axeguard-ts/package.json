{
  "name": "petroshield-axeguard-tui",
  "version": "1.0.0",
  "description": "PetroShield AxeGuard TUI — Dashboard SOC Agentic em Node/TS + Ink + Bun",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.tsx",
    "build": "bun build src/index.tsx --outdir ./dist --target node",
    "launch": "bun run dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "figlet": "^1.7.0",
    "gradient-string": "^3.0.0",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "react": "^18.3.1",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/figlet": "^1.5.8",
    "typescript": "^5.4.5"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
